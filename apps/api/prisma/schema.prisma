// Спектр — модель данных.
// Прототип работает на SQLite. Для продакшена поменяйте provider на "postgresql"
// и DATABASE_URL — схема совместима. Статусы и роли хранятся строками,
// допустимые значения описаны в src/lib/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  passwordHash     String?
  name             String
  phone            String?
  avatarUrl        String?
  // STUDENT | TEACHER | ADMIN
  role             String    @default("STUDENT")
  telegramId       String?   @unique
  vkId             String?   @unique
  maxId            String?   @unique
  emailVerified    Boolean   @default(false)
  // токены, выданные раньше этого момента, недействительны («выйти на всех устройствах», смена пароля)
  tokensValidAfter DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  teacher          Teacher?
  memberships      GroupMember[]
  lessonsAsStudent Lesson[]            @relation("LessonStudent")
  bookings         Booking[]
  reschedules      RescheduleRequest[]
  tickets          SupportTicket[]
  ticketMessages   TicketMessage[]
  enrollments      Enrollment[]
  assignments      Assignment[]
}

model Teacher {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug       String   @unique
  subject    String
  headline   String
  bio        String
  experience Int      @default(0)
  photoUrl   String?
  // Индекс цвета спектра 0..6 — используется для плейсхолдера и акцентов
  hue        Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())

  groups      Group[]
  lessons     Lesson[]
  courses     Course[]
  assignments Assignment[]
}

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String
  description   String
  // SCHOOL | UNIVERSITY — университетские курсы подключатся позже
  source        String   @default("SCHOOL")
  university    String?
  // Кому: SCHOOL — школьникам, STUDENTS — студентам, ALL — всем
  audience      String   @default("SCHOOL")
  level         String   @default("Любой")
  format        String   @default("Группа")
  durationWeeks Int      @default(8)
  priceFrom     Int      @default(0)
  hue           Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())

  teacherId   String?
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  groups      Group[]
  bookings    Booking[]
  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  // PENDING | ACTIVE | DECLINED
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Group {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  coverUrl    String?
  hue         Int      @default(0)
  schedule    String   @default("")
  capacity    Int      @default(6)
  createdAt   DateTime @default(now())

  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  members     GroupMember[]
  photos      GroupPhoto[]
  lessons     Lesson[]
  assignments Assignment[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupPhoto {
  id        String   @id @default(cuid())
  groupId   String
  url       String
  caption   String?
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  durationMin Int      @default(60)
  link        String?
  notes       String?
  // SCHEDULED | DONE | CANCELLED
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // Групповое занятие — groupId; индивидуальное — studentId
  groupId   String?
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String?
  student   User?   @relation("LessonStudent", fields: [studentId], references: [id], onDelete: Cascade)

  reschedules RescheduleRequest[]
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  contact       String
  preferredTime String?
  // INDIVIDUAL | GROUP
  format        String?
  comment       String?
  // NEW | CONTACTED | SCHEDULED | CLOSED
  status        String   @default("NEW")
  createdAt     DateTime @default(now())

  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  courseId    String?
  course      Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherSlug String?
}

model RescheduleRequest {
  id         String    @id @default(cuid())
  reason     String
  proposedAt DateTime?
  // PENDING | APPROVED | DECLINED
  status     String    @default("PENDING")
  reply      String?
  createdAt  DateTime  @default(now())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String   @id @default(cuid())
  subject   String
  // OPEN | ANSWERED | CLOSED
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// Одноразовые коды из писем: подтверждение почты и смена пароля
model EmailCode {
  id        String   @id @default(cuid())
  email     String
  // VERIFY | RESET
  purpose   String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// ─── Telegram-бот ───

// Каждый, кто запускал бота: прогресс в игре «Радуга знаний», приглашения, настройки
model BotPlayer {
  chatId       String   @id
  firstName    String
  username     String?
  // собранные цвета радуги, по биту на цвет (7 бит)
  colors       Int      @default(0)
  rainbows     Int      @default(0)
  streak       Int      @default(0)
  bestStreak   Int      @default(0)
  // день по Москве (YYYY-MM-DD), когда играл последний раз, и сколько вопросов в этот день
  lastDay      String?
  todayCount   Int      @default(0)
  // лишние вопросы за приглашённых друзей
  bonus        Int      @default(0)
  invitedBy    String?
  invited      Int      @default(0)
  colorTest    String?
  reminders    Boolean  @default(true)
  createdAt    DateTime @default(now())
  // telegram | max. У MAX chatId хранится с префиксом «max:»
  platform     String   @default("telegram")
  lastName     String?
  // сообщение-«экран», которое бот редактирует вместо отправки новых
  screenId     String?
  lastSeen     DateTime @default(now())
  // «Задача дня»: последний решённый день, серия, общее число решённых
  dailyDay     String?
  dailyStreak  Int      @default(0)
  dailySolved  Int      @default(0)
  // напоминать о задаче дня вечером
  dailyPush    Boolean  @default(true)
  dailyPushDay String?
  // ссылка из рекламы или от друга: откуда пришёл
  source       String?
  // класс для тренажёра в боте (5–11) и сколько решено в нём
  grade        Int?
  trainSolved  Int      @default(0)
}

// Отправленные напоминания о занятиях, чтобы не слать дважды
model BotReminder {
  id       String   @id @default(cuid())
  lessonId String
  chatId   String
  sentAt   DateTime @default(now())

  @@unique([lessonId, chatId])
}

// Вопрос ученика, пересланный администратору: ответ на это сообщение уходит ученику
model BotRelay {
  id             String   @id @default(cuid())
  adminChatId    String
  adminMessageId Int
  userChatId     String?
  ticketId       String?
  createdAt      DateTime @default(now())

  @@unique([adminChatId, adminMessageId])
}

// Одноразовая ссылка «привязать Telegram» из профиля на сайте
model TelegramLinkCode {
  code      String   @id
  userId    String
  expiresAt DateTime
}

// ─── Аналитика ───

// Посетитель сайта или мини-приложения: id генерирует браузер и хранит у себя
model Visitor {
  id          String   @id
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  visits      Int      @default(1)
  views       Int      @default(0)
  // web | telegram | vk | max
  platform    String   @default("web")
  // откуда пришёл в первый раз: direct | search | social | telegram | vk | max | referral | ads
  source      String   @default("direct")
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landing     String?
  device      String?
  userId      String?

  @@index([userId])
  @@index([lastSeen])
}

// Событие: просмотр страницы, начало записи, решённая задача, действие в боте и т. д.
model Event {
  id        String   @id @default(cuid())
  visitorId String?
  userId    String?
  // для событий из ботов: id игрока (BotPlayer.chatId)
  playerId  String?
  type      String
  path      String?
  label     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([userId])
  @@index([playerId])
  @@index([type, createdAt])
}

// ─── Практикум ───

// Попытка решить задачу из практикума (гость или ученик)
model PracticeAttempt {
  id        String   @id @default(cuid())
  problemId String
  topic     String
  visitorId String?
  userId    String?
  playerId  String?
  correct   Boolean
  answer    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([visitorId])
  @@index([problemId])
}

// Домашнее задание: задачи практикума и/или своё задание от преподавателя
model Assignment {
  id         String    @id @default(cuid())
  title      String
  note       String    @default("")
  // id задач практикума через запятую
  problemIds String    @default("")
  dueAt      DateTime?
  createdAt  DateTime  @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String?
  student   User?   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  marks AssignmentMark[]
}

// Отметка ученика по домашке: «сделал» и ответ на своё задание преподавателя
model AssignmentMark {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  done         Boolean    @default(false)
  answer       String     @default("")
  comment      String     @default("")
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, userId])
}

// ─── Родителям ───

// Ссылка для родителя: открывает отчёт об успехах ребёнка без входа в аккаунт
model ParentLink {
  token     String    @id
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Родитель подписался в боте на еженедельный отчёт
model ParentSub {
  id        String   @id @default(cuid())
  token     String
  chatId    String
  lastSent  String?
  createdAt DateTime @default(now())

  @@unique([token, chatId])
}

// ─── Турнир недели ───

model TournamentEntry {
  id         String    @id @default(cuid())
  // неделя по ISO, например 2026-W41
  week       String
  // junior (5–6), middle (7–8), oge (9), ege (10–11)
  league     String
  userId     String?
  visitorId  String?
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int       @default(0)
  timeMs     Int       @default(0)
  // ответы участника JSON-строкой
  answers    String    @default("")
  hidden     Boolean   @default(false)

  @@index([week, league])
  @@index([userId])
  @@index([visitorId])
}
